{
  "$id": "https://onecrew.local/schemas/ProviderJobState.schema.json",
  "title": "ProviderJobState",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "output": {},
    "actualCostCny": {
      "type": "number",
      "minimum": 0
    },
    "errorCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "errorMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "required": [
    "status"
  ],
  "additionalProperties": false
}
