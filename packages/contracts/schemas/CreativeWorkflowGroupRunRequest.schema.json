{
  "$id": "https://onecrew.local/schemas/CreativeWorkflowGroupRunRequest.schema.json",
  "title": "CreativeWorkflowGroupRunRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expectedGroupVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "expectedShotVersions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "route": {
      "default": "primary",
      "type": "string",
      "enum": [
        "primary",
        "fallback"
      ]
    },
    "generationNonce": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "forceRegenerate": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "expectedGroupVersion",
    "expectedShotVersions",
    "route",
    "generationNonce",
    "forceRegenerate"
  ],
  "additionalProperties": false
}
