{
  "$id": "https://onecrew.local/schemas/CreativeGenerationBatchRequest.schema.json",
  "title": "CreativeGenerationBatchRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ]
    },
    "shotIds": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      }
    },
    "expectedVersions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "missingOnly": {
      "default": true,
      "type": "boolean"
    },
    "route": {
      "default": "primary",
      "type": "string",
      "enum": [
        "primary",
        "fallback"
      ]
    },
    "generationNonce": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "concurrency": {
      "default": 3,
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    }
  },
  "required": [
    "kind",
    "expectedVersions",
    "missingOnly",
    "route",
    "generationNonce",
    "concurrency"
  ],
  "additionalProperties": false
}
