{
  "$id": "https://onecrew.local/schemas/QCRunRecord.schema.json",
  "title": "QCRunRecord",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "qcRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "request": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "shotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "sourceAssetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "sourceJobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "sourceRenderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "mediaUri": {
          "type": "string",
          "format": "uri"
        },
        "mediaType": {
          "type": "string",
          "enum": [
            "image",
            "video"
          ]
        },
        "expectedDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "criteria": {
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "technical": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "fps": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 120
            },
            "durationSec": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 7200
            },
            "durationToleranceSec": {
              "default": 0.35,
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "requireAudio": {
              "default": false,
              "type": "boolean"
            },
            "allowedVideoCodecs": {
              "default": [
                "h264"
              ],
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "allowedAudioCodecs": {
              "default": [
                "aac",
                "mp3"
              ],
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "allowedPixelFormats": {
              "default": [
                "yuv420p"
              ],
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "colorSpace": {
              "type": "string",
              "minLength": 1
            },
            "maxBlackDurationSec": {
              "default": 0.75,
              "type": "number",
              "minimum": 0,
              "maximum": 60
            },
            "maxFreezeDurationSec": {
              "default": 1.5,
              "type": "number",
              "minimum": 0,
              "maximum": 60
            },
            "ignoreFreezeTailSec": {
              "default": 0,
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "maxSilenceDurationSec": {
              "default": 2,
              "type": "number",
              "minimum": 0,
              "maximum": 600
            },
            "minIntegratedLufs": {
              "type": "number",
              "minimum": -100,
              "maximum": 0
            },
            "maxIntegratedLufs": {
              "type": "number",
              "minimum": -100,
              "maximum": 0
            },
            "maxTruePeakDbtp": {
              "type": "number",
              "minimum": -100,
              "maximum": 20
            },
            "maxBrightnessJump": {
              "default": 70,
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 255
            },
            "minSceneChanges": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "minVisualVariationRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "subtitleCues": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "lineId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                  },
                  "startMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "endMs": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "lineId",
                  "startMs",
                  "endMs"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "durationToleranceSec",
            "requireAudio",
            "allowedVideoCodecs",
            "allowedAudioCodecs",
            "allowedPixelFormats",
            "maxBlackDurationSec",
            "maxFreezeDurationSec",
            "ignoreFreezeTailSec",
            "maxSilenceDurationSec",
            "maxBrightnessJump",
            "subtitleCues"
          ],
          "additionalProperties": false
        },
        "route": {
          "default": "primary",
          "type": "string",
          "enum": [
            "primary",
            "fallback"
          ]
        },
        "qualityAttempt": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "autoRemediate": {
          "default": true,
          "type": "boolean"
        },
        "remediation": {
          "default": "generation",
          "type": "string",
          "enum": [
            "generation",
            "remotion"
          ]
        }
      },
      "required": [
        "projectId",
        "mediaUri",
        "mediaType",
        "expectedDescription",
        "criteria",
        "technical",
        "route",
        "qualityAttempt",
        "autoRemediate",
        "remediation"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting_provider",
        "waiting_human",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "technicalReport": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "probe": {
          "type": "object",
          "properties": {
            "durationSec": {
              "type": "number",
              "minimum": 0
            },
            "width": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "fps": {
              "type": "number",
              "minimum": 0
            },
            "videoCodec": {
              "type": "string",
              "minLength": 1
            },
            "pixelFormat": {
              "type": "string",
              "minLength": 1
            },
            "colorRange": {
              "type": "string",
              "minLength": 1
            },
            "colorSpace": {
              "type": "string",
              "minLength": 1
            },
            "audioCodec": {
              "type": "string",
              "minLength": 1
            },
            "sampleRate": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "channels": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "bitRate": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "durationSec",
            "width",
            "height",
            "fps",
            "videoCodec",
            "pixelFormat"
          ],
          "additionalProperties": false
        },
        "blackSegments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startSec": {
                "type": "number",
                "minimum": 0
              },
              "endSec": {
                "type": "number",
                "minimum": 0
              },
              "durationSec": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "startSec",
              "endSec",
              "durationSec"
            ],
            "additionalProperties": false
          }
        },
        "freezeSegments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startSec": {
                "type": "number",
                "minimum": 0
              },
              "endSec": {
                "type": "number",
                "minimum": 0
              },
              "durationSec": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "startSec",
              "endSec",
              "durationSec"
            ],
            "additionalProperties": false
          }
        },
        "silenceSegments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startSec": {
                "type": "number",
                "minimum": 0
              },
              "endSec": {
                "type": "number",
                "minimum": 0
              },
              "durationSec": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "startSec",
              "endSec",
              "durationSec"
            ],
            "additionalProperties": false
          }
        },
        "integratedLufs": {
          "type": "number"
        },
        "truePeakDbtp": {
          "type": "number"
        },
        "maxBrightnessJump": {
          "type": "number",
          "minimum": 0
        },
        "sceneChanges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sampledFrameCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "visualVariationRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "checks": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "passed": {
                "type": "boolean"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "warning",
                  "error"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "actual": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "expected": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            },
            "required": [
              "code",
              "passed",
              "severity",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "analyzedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "passed",
        "probe",
        "blackSegments",
        "freezeSegments",
        "silenceSegments",
        "checks",
        "analyzedAt"
      ],
      "additionalProperties": false
    },
    "semanticReport": {
      "type": "object",
      "properties": {
        "scores": {
          "type": "object",
          "properties": {
            "character": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "clothing": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "background": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "action": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "flicker": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "lipsync": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "subtitle": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "brand": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "safeArea": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "audio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "compliance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "character",
            "clothing",
            "background",
            "action",
            "flicker",
            "lipsync",
            "subtitle",
            "brand",
            "safeArea",
            "audio",
            "compliance"
          ],
          "additionalProperties": false
        },
        "decision": {
          "type": "string",
          "enum": [
            "pass",
            "regenerate",
            "switch_model",
            "manual"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "retryPatch": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "scores",
        "decision",
        "reason"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "string",
      "enum": [
        "pass",
        "regenerate",
        "switch_model",
        "manual"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "retryPatch": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "vlmJobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "remediationJobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "remediationRenderId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "qcRecordId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "gateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "reviewCard": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "reviewDelivery": {
      "type": "string",
      "enum": [
        "mock_outbox",
        "sent",
        "unconfigured"
      ]
    },
    "errorCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "errorMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "qcRunId",
    "request",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
