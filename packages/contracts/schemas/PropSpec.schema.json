{
  "$id": "https://onecrew.local/schemas/PropSpec.schema.json",
  "title": "PropSpec",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "episodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    },
    "prompt": {
      "type": "string",
      "maxLength": 20000
    },
    "polishedPrompt": {
      "type": "string",
      "maxLength": 20000
    },
    "negativePrompt": {
      "type": "string",
      "maxLength": 10000
    },
    "referenceAssetIds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      }
    },
    "extraAssetIds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      }
    },
    "sortOrder": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "default": "draft",
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "archived"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "enum": [
            "onecrew",
            "local-mini-drama",
            "manual",
            "import"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "importedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "system"
      ],
      "additionalProperties": false
    },
    "kind": {
      "type": "string",
      "const": "prop"
    },
    "category": {
      "type": "string",
      "maxLength": 300
    }
  },
  "required": [
    "entityId",
    "projectId",
    "name",
    "referenceAssetIds",
    "extraAssetIds",
    "sortOrder",
    "status",
    "kind"
  ],
  "additionalProperties": false
}
