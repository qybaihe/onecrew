{
  "$id": "https://onecrew.local/schemas/DesignPackManifest.schema.json",
  "title": "DesignPackManifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "designSystemId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "designMdUri": {
      "type": "string",
      "format": "uri"
    },
    "brandTokensUri": {
      "type": "string",
      "format": "uri"
    },
    "motionTokensUri": {
      "type": "string",
      "format": "uri"
    },
    "promoSpecUri": {
      "type": "string",
      "format": "uri"
    },
    "assetUris": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "open-design",
        "manual"
      ]
    },
    "sourceLicense": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "designSystemId",
    "version",
    "designMdUri",
    "brandTokensUri",
    "motionTokensUri",
    "promoSpecUri",
    "assetUris",
    "source",
    "createdAt"
  ],
  "additionalProperties": false
}
