{
  "$id": "https://onecrew.local/schemas/CreativeGenerationBatch.schema.json",
  "title": "CreativeGenerationBatch",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "batchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "submitting",
        "running",
        "waiting_human",
        "succeeded",
        "partial",
        "failed",
        "cancelled"
      ]
    },
    "missingOnly": {
      "type": "boolean"
    },
    "route": {
      "type": "string",
      "enum": [
        "primary",
        "fallback"
      ]
    },
    "generationNonce": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "items": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shotId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "expectedVersion": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "skipped",
              "submission_failed",
              "queued",
              "running",
              "waiting_human",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "jobId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "mock",
              "sandbox",
              "real"
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "estimatedCostCny": {
            "type": "number",
            "minimum": 0
          },
          "outputAssetIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            }
          },
          "retryCount": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "shotId",
          "expectedVersion",
          "status",
          "outputAssetIds",
          "retryCount"
        ],
        "additionalProperties": false
      }
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "batchId",
    "projectId",
    "kind",
    "status",
    "missingOnly",
    "route",
    "generationNonce",
    "concurrency",
    "items",
    "inputHash",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
