{
  "$id": "https://onecrew.local/schemas/PublishRecord.schema.json",
  "title": "PublishRecord",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "publishId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "request": {
      "type": "object",
      "properties": {
        "publishId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "episode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "designPack": {
          "type": "object",
          "properties": {
            "designSystemId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "designMdUri": {
              "type": "string",
              "format": "uri"
            },
            "brandTokensUri": {
              "type": "string",
              "format": "uri"
            },
            "motionTokensUri": {
              "type": "string",
              "format": "uri"
            },
            "promoSpecUri": {
              "type": "string",
              "format": "uri"
            },
            "assetUris": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            },
            "source": {
              "type": "string",
              "enum": [
                "open-design",
                "manual"
              ]
            },
            "sourceLicense": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "designSystemId",
            "version",
            "designMdUri",
            "brandTokensUri",
            "motionTokensUri",
            "promoSpecUri",
            "assetUris",
            "source",
            "createdAt"
          ],
          "additionalProperties": false
        },
        "localePacks": {
          "minItems": 2,
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "projectId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "locale": {
                "type": "string",
                "enum": [
                  "zh-CN",
                  "en-US"
                ]
              },
              "version": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "sourceLocale": {
                "type": "string",
                "enum": [
                  "zh-CN",
                  "en-US"
                ]
              },
              "translationMode": {
                "type": "string",
                "enum": [
                  "source",
                  "mock",
                  "sandbox",
                  "real",
                  "manual"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "lineId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                    },
                    "sourceLineId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                    },
                    "shotId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                    },
                    "speaker": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 5000
                    },
                    "startMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "endMs": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "voiceId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                    },
                    "audioAssetId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                    },
                    "audioUri": {
                      "type": "string",
                      "format": "uri"
                    },
                    "audioDurationMs": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "translationNotes": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  },
                  "required": [
                    "lineId",
                    "shotId",
                    "speaker",
                    "text",
                    "startMs",
                    "endMs",
                    "voiceId"
                  ],
                  "additionalProperties": false
                }
              },
              "cta": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "marketingCopy": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "shotTimingAdjustments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "shotId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                    },
                    "sourceStartFrame": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "sourceEndFrame": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "localizedStartFrame": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "localizedEndFrame": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "shotId",
                    "sourceStartFrame",
                    "sourceEndFrame",
                    "localizedStartFrame",
                    "localizedEndFrame"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "projectId",
              "locale",
              "title",
              "lines",
              "cta",
              "marketingCopy"
            ],
            "additionalProperties": false
          }
        },
        "creatives": {
          "minItems": 8,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "creativeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "projectId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "locale": {
                "type": "string",
                "enum": [
                  "zh-CN",
                  "en-US"
                ]
              },
              "compositionId": {
                "type": "string",
                "enum": [
                  "Trailer30",
                  "Teaser15Vertical",
                  "Bumper6",
                  "MotionPoster"
                ]
              },
              "aspectRatio": {
                "type": "string",
                "enum": [
                  "16:9",
                  "9:16",
                  "1:1"
                ]
              },
              "renderId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "mediaUri": {
                "type": "string",
                "format": "uri"
              },
              "hook": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "cta": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "coverUri": {
                "type": "string",
                "format": "uri"
              },
              "platforms": {
                "minItems": 1,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "抖音",
                    "TikTok",
                    "YouTube",
                    "其他"
                  ]
                }
              }
            },
            "required": [
              "creativeId",
              "projectId",
              "locale",
              "compositionId",
              "aspectRatio",
              "renderId",
              "mediaUri",
              "hook",
              "cta",
              "platforms"
            ],
            "additionalProperties": false
          }
        },
        "delivery": {
          "default": "package_export",
          "type": "string",
          "const": "package_export"
        }
      },
      "required": [
        "publishId",
        "projectId",
        "episode",
        "designPack",
        "localePacks",
        "creatives",
        "delivery"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "building",
        "succeeded",
        "failed"
      ]
    },
    "packageUri": {
      "type": "string",
      "format": "uri"
    },
    "packageHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packageBytes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "experimentIds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      }
    },
    "feishuWriteback": {
      "type": "string",
      "enum": [
        "sent",
        "mock_outbox",
        "unconfigured"
      ]
    },
    "errorCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "errorMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "publishId",
    "request",
    "status",
    "experimentIds",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
