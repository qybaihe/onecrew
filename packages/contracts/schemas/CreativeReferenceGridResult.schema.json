{
  "$id": "https://onecrew.local/schemas/CreativeReferenceGridResult.schema.json",
  "title": "CreativeReferenceGridResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "entityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "sourceAssetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "rows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "tileAssetIds": {
      "minItems": 2,
      "maxItems": 9,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      }
    },
    "entityVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "replayed": {
      "type": "boolean"
    }
  },
  "required": [
    "projectId",
    "entityId",
    "sourceAssetId",
    "rows",
    "columns",
    "tileAssetIds",
    "entityVersion",
    "replayed"
  ],
  "additionalProperties": false
}
