{
  "$id": "https://onecrew.local/schemas/LocalizedTextPack.schema.json",
  "title": "LocalizedTextPack",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "cta": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "marketingCopy": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "lines": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceLineId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "speaker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "translationNotes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "sourceLineId",
          "speaker",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "cta",
    "marketingCopy",
    "lines"
  ],
  "additionalProperties": false
}
