{
  "$id": "https://onecrew.local/schemas/CreativeReferenceGridRequest.schema.json",
  "title": "CreativeReferenceGridRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sourceAssetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "expectedEntityVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "rows": {
      "default": 2,
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "columns": {
      "default": 2,
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "actorOpenId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    }
  },
  "required": [
    "sourceAssetId",
    "expectedEntityVersion",
    "rows",
    "columns",
    "actorOpenId"
  ],
  "additionalProperties": false
}
