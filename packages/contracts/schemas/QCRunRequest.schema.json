{
  "$id": "https://onecrew.local/schemas/QCRunRequest.schema.json",
  "title": "QCRunRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "shotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "sourceAssetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "sourceJobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "sourceRenderId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "mediaUri": {
      "type": "string",
      "format": "uri"
    },
    "mediaType": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ]
    },
    "expectedDescription": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "criteria": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "technical": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "durationSec": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 7200
        },
        "durationToleranceSec": {
          "default": 0.35,
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "requireAudio": {
          "default": false,
          "type": "boolean"
        },
        "allowedVideoCodecs": {
          "default": [
            "h264"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowedAudioCodecs": {
          "default": [
            "aac",
            "mp3"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowedPixelFormats": {
          "default": [
            "yuv420p"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "colorSpace": {
          "type": "string",
          "minLength": 1
        },
        "maxBlackDurationSec": {
          "default": 0.75,
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "maxFreezeDurationSec": {
          "default": 1.5,
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "ignoreFreezeTailSec": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "maxSilenceDurationSec": {
          "default": 2,
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "minIntegratedLufs": {
          "type": "number",
          "minimum": -100,
          "maximum": 0
        },
        "maxIntegratedLufs": {
          "type": "number",
          "minimum": -100,
          "maximum": 0
        },
        "maxTruePeakDbtp": {
          "type": "number",
          "minimum": -100,
          "maximum": 20
        },
        "maxBrightnessJump": {
          "default": 70,
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 255
        },
        "minSceneChanges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "minVisualVariationRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "subtitleCues": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lineId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "startMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "lineId",
              "startMs",
              "endMs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "durationToleranceSec",
        "requireAudio",
        "allowedVideoCodecs",
        "allowedAudioCodecs",
        "allowedPixelFormats",
        "maxBlackDurationSec",
        "maxFreezeDurationSec",
        "ignoreFreezeTailSec",
        "maxSilenceDurationSec",
        "maxBrightnessJump",
        "subtitleCues"
      ],
      "additionalProperties": false
    },
    "route": {
      "default": "primary",
      "type": "string",
      "enum": [
        "primary",
        "fallback"
      ]
    },
    "qualityAttempt": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "autoRemediate": {
      "default": true,
      "type": "boolean"
    },
    "remediation": {
      "default": "generation",
      "type": "string",
      "enum": [
        "generation",
        "remotion"
      ]
    }
  },
  "required": [
    "projectId",
    "mediaUri",
    "mediaType",
    "expectedDescription",
    "criteria",
    "technical",
    "route",
    "qualityAttempt",
    "autoRemediate",
    "remediation"
  ],
  "additionalProperties": false
}
