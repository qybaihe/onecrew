{
  "$id": "https://onecrew.local/schemas/ProjectSpec.schema.json",
  "title": "ProjectSpec",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "nameZh": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "nameEn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "synopsis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "genres": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "ownerOpenId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "locales": {
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "zh-CN",
          "en-US"
        ]
      }
    },
    "aspectRatios": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "16:9",
          "9:16",
          "1:1"
        ]
      }
    },
    "budgetLimitCny": {
      "type": "number",
      "minimum": 0
    },
    "designSystemId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "style": {
      "type": "string",
      "maxLength": 500
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "totalEpisodes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "source": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "enum": [
            "onecrew",
            "local-mini-drama",
            "manual",
            "import"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "importedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "system"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "running",
        "waiting_human",
        "done",
        "failed"
      ]
    }
  },
  "required": [
    "projectId",
    "nameZh",
    "nameEn",
    "synopsis",
    "audience",
    "genres",
    "ownerOpenId",
    "locales",
    "aspectRatios",
    "budgetLimitCny",
    "status"
  ],
  "additionalProperties": false
}
