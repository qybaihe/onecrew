{
  "$id": "https://onecrew.local/schemas/CreativeStoryPlanRequest.schema.json",
  "title": "CreativeStoryPlanRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "brief": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "episodeCount": {
      "default": 3,
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "route": {
      "default": "primary",
      "type": "string",
      "enum": [
        "primary",
        "fallback"
      ]
    },
    "generationNonce": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "brief",
    "episodeCount",
    "route",
    "generationNonce"
  ],
  "additionalProperties": false
}
