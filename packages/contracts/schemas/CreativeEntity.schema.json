                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                }
              }
            },
            "required": [
              "stageId",
              "name",
              "referenceAssetIds"
            ],
            "additionalProperties": false
          }
        },
        "providerAssetRef": {
          "type": "string",
          "maxLength": 2000
        }
