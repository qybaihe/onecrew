            "system"
          ],
          "additionalProperties": false
        },
        "kind": {
          "type": "string",
          "const": "character"
        },
        "role": {
          "type": "string",
          "maxLength": 500
        },
        "personality": {
          "type": "string",
          "maxLength": 4000
        },
        "appearance": {
          "type": "string",
          "maxLength": 10000
        },
        "voiceStyle": {
          "type": "string",
          "maxLength": 2000
        },
        "identityAnchors": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "styleTokens": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
