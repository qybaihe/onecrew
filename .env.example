# OneCrew API
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
APP_VERSION=0.1.0

# PostgreSQL (local defaults only; replace outside local development)
POSTGRES_USER=onecrew
POSTGRES_PASSWORD=onecrew-local-postgres
POSTGRES_DB=onecrew
POSTGRES_PORT=55432
DATABASE_URL=postgresql://onecrew:onecrew-local-postgres@127.0.0.1:55432/onecrew

# Redis
REDIS_PASSWORD=onecrew-local-redis
REDIS_PORT=56379
REDIS_URL=redis://:onecrew-local-redis@127.0.0.1:56379/0

# S3-compatible local object storage
MINIO_ROOT_USER=onecrew
MINIO_ROOT_PASSWORD=onecrew-local-minio-secret
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=onecrew
S3_ACCESS_KEY=onecrew
S3_SECRET_KEY=onecrew-local-minio-secret

# Provider Gateway defaults to deterministic Mock and never spends provider credits.
# Set PROVIDER_MODE=real only after every required key, model ID, callback secret, and current CNY price is configured.
PROVIDER_MODE=mock
PROVIDER_QUEUE_CONCURRENCY=5
PROVIDER_POLL_INTERVAL_MS=2000
PROVIDER_SOFT_BUDGET_RATIO=0.8
PROVIDER_CALLBACK_SECRET=

# Remotion renderer. Each render can use multiple Chromium/FFmpeg workers, so keep queue concurrency conservative.
RENDER_QUEUE_CONCURRENCY=1
RENDER_CANCEL_POLL_MS=500
QC_QUEUE_CONCURRENCY=1
QC_PROVIDER_POLL_MS=500
QC_PROVIDER_TIMEOUT_MS=600000
QC_PROVIDER_FAILURE_GRACE_MS=5000
QC_CANCEL_POLL_MS=500
LOCALIZATION_QUEUE_CONCURRENCY=1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
REMOTION_BROWSER_EXECUTABLE=
REMOTION_FINAL_MAX_DIMENSION=

# LLM + image-VLM (OpenAI Responses API). Real smoke test is not run without credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_VLM_MODEL=
OPENAI_INPUT_CNY_PER_MILLION_TOKENS=0
OPENAI_OUTPUT_CNY_PER_MILLION_TOKENS=0

# Image + video (Volcengine Ark Seedream/Seedance). Model IDs and prices are account-specific.
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODEL=
SEEDREAM_COST_CNY_PER_IMAGE=0
SEEDANCE_MODEL=
SEEDANCE_COST_CNY_PER_SECOND=0

# TTS (ElevenLabs). Voice ID is supplied per request.
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_MODEL=
ELEVENLABS_COST_CNY_PER_THOUSAND_CHARACTERS=0

# Feishu: leave empty until a real custom app and Base are authorized.
# Never commit real values. Missing values keep Feishu in fixture/config-check mode.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_APP_TOKEN=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_ALLOWED_OPEN_IDS=
FEISHU_QC_RECEIVE_ID=
FEISHU_QC_RECEIVE_ID_TYPE=open_id
